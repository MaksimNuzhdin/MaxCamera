[Unit]
Description=MaxCamera isolated web console
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workarea/GPTPlayground/MaxCameraWeb/webapp
ExecStart=/usr/bin/python3 %h/workarea/GPTPlayground/MaxCameraWeb/webapp/launch.py --secure-cookie
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=default.target
