[Unit]
Description=MaxCamera outbound HTTPS tunnel (requires provider approval)
After=maxcamera-web.service
Requires=maxcamera-web.service

[Service]
Type=simple
ExecStart=%h/workarea/GPTPlayground/MaxCameraWeb/webapp/.runtime/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8787 --protocol http2
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
